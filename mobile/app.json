{
  "expo": {
    "name": "Smittenbrot",
    "slug": "smittenbrot",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.smittenbrot.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app does not need camera access.",
        "NSPhotoLibraryUsageDescription": "This app does not need photo library access.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de"
        ]
      },
      "buildNumber": "26"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "de.smittenbrot.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 17
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/kaching.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.de.smittenbrot.app",
          "enableGooglePay": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "smittenbrot",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "60b1dbbc-f675-4169-bd0d-114e4e6cd013"
      }
    },
    "owner": "stockdorfagent",
    "locales": {
      "de": "./locales/de.json"
    }
  }
}
